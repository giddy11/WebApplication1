{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ===================================================================
  // These four values are read in Program.cs (TokenValidationParameters)
  // and in JwtTokenService, and they work together as a matched set:
  // the SAME Issuer/Audience/Key must be used both when a token is
  // CREATED (login/signup) and when it is CHECKED (every later request).
  // If any one of the three differs between those two places, every
  // token gets rejected as invalid.
  // ===================================================================
  "Jwt": {
    // "Who issued this token?" -- a label for OUR app. JwtTokenService
    // stamps this into every token's "iss" claim; Program.cs then checks
    // incoming tokens carry the exact same value. Stops a token minted
    // by some other API from being reused here.
    "Issuer": "SchoolManagementSystem",

    // "Who is this token meant for?" -- a label for the client(s) allowed
    // to use it (e.g. our Swagger UI / front-end). Stamped into the "aud"
    // claim the same way as Issuer. Stops a token meant for a different
    // API from being replayed against this one.
    "Audience": "SchoolManagementSystemClient",

    // Think of every token as a note ("Grace is a Principal") stamped with
    // a rubber stamp -- and this Key is the one-of-a-kind ink pattern on
    // that stamp. JwtTokenService presses this "stamp" onto every token it
    // hands out; Program.cs later re-presses the same stamp on the token
    // it receives back and checks the imprint matches, to make sure
    // nothing was edited along the way.
    //
    // Whoever holds this Key can make their OWN perfectly valid-looking
    // stamp for ANY note they like -- e.g. "I am Principal" -- and our
    // server would trust it. So this is less like a password for one
    // account, and more like the master tool that can forge trust for
    // every account and every role at once. It must never be committed
    // to a public repo or shared outside the team. For a real
    // (non-workshop) app, move this out of appsettings.json into
    // `dotnet user-secrets` (locally) or an environment variable /
    // secret manager (in production) instead -- appsettings.json usually
    // ends up in git, and anything committed to git stays in its history
    // even after you delete it later.
    "Key": "LYh7kF2mlz2YvZIIMe9lAkj/rEZkzVIs138HE2nhm7GMaNy5/LOOqs9qYG7jqw9d",

    // How many minutes a token stays valid after login/signup, after
    // which ValidateLifetime in Program.cs starts rejecting it and the
    // user has to log in again to get a fresh one.
    "ExpiryMinutes": "60"
  }
}
